{
  "entities": {
    "User": {
      "title": "Account Identity",
      "description": "Global user identity (usr_xxx). Linked to one or more staff roles.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "email", "name", "createdAt"]
    },
    "InviteCode": {
      "title": "Invite Code",
      "description": "Secure invite for joining a company (inv_xxx).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "companyId": { "type": "string" },
        "storeId": { "type": "string" },
        "role": { "type": "string" },
        "expiresAt": { "type": "number" },
        "used": { "type": "boolean" },
        "usedBy": { "type": "string" }
      },
      "required": ["id", "code", "companyId", "storeId", "role", "expiresAt", "used"]
    },
    "Enterprise": {
      "title": "Company",
      "description": "Main organization details (cmp_xxx).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "ownerId", "createdAt"]
    },
    "Shop": {
      "title": "Store/Branch",
      "description": "Branch of a company (str_xxx).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "enterpriseId": { "type": "string" },
        "companyId": { "type": "string" },
        "regionId": { "type": "string" },
        "address": { "type": "string" },
        "cnpj": { "type": "string" }
      },
      "required": ["id", "name", "enterpriseId"]
    },
    "Staff": {
      "title": "Employee",
      "description": "Relationship between a user and a company/store (emp_xxx).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "enterpriseId": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "active": { "type": "boolean" },
        "pin": { "type": "string" },
        "assignedShopIds": { "type": "array" }
      },
      "required": ["id", "enterpriseId", "name", "role", "active"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory or menu item (pro_xxx).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "enterpriseId": { "type": "string" },
        "shopId": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "enterpriseId", "shopId", "name", "price", "category", "active"]
    },
    "Order": {
      "title": "Order",
      "description": "POS transaction (ord_xxx).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "enterpriseId": { "type": "string" },
        "shopId": { "type": "string" },
        "tableId": { "type": "string" },
        "items": { "type": "array" },
        "status": { "type": "string" },
        "total": { "type": "number" },
        "startTime": { "type": "number" }
      },
      "required": ["id", "enterpriseId", "shopId", "tableId", "status", "total", "items", "startTime"]
    },
    "Table": {
      "title": "Table",
      "description": "Dining table (tbl_xxx).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "enterpriseId": { "type": "string" },
        "shopId": { "type": "string" },
        "number": { "type": "number" },
        "status": { "type": "string" },
        "capacity": { "type": "number" }
      },
      "required": ["id", "enterpriseId", "shopId", "number", "status", "capacity"]
    },
    "Transaction": {
      "title": "Payment Receipt",
      "description": "Financial record of a sale (trx_xxx).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "enterpriseId": { "type": "string" },
        "shopId": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "timestamp": { "type": "number" },
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "module": { "type": "string" },
        "referenceId": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "enterpriseId", "amount", "paymentMethod", "timestamp", "staffId", "module", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Global identities." },
    "/invites/{inviteId}": { "schema": "InviteCode", "description": "Company invites." },
    "/enterprises/{entId}": { "schema": "Enterprise", "description": "Organization data." },
    "/shops/{shopId}": { "schema": "Shop", "description": "Stores." },
    "/staff/{staffId}": { "schema": "Staff", "description": "Employee profiles." },
    "/products/{productId}": { "schema": "Product", "description": "Inventory products." },
    "/orders/{orderId}": { "schema": "Order", "description": "Sales records." },
    "/tables/{tableId}": { "schema": "Table", "description": "Dining tables." },
    "/transactions/{trxId}": { "schema": "Transaction", "description": "Payment history." }
  }
}
