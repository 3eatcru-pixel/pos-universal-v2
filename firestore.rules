rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function authTenantId() {
      return request.auth.token.companyId != null
        ? request.auth.token.companyId
        : request.auth.token.enterpriseId;
    }

    function isAdmin() {
      return isSignedIn() &&
        (
          request.auth.token.role == 'dev' ||
          request.auth.token.email == "novaapp26@gmail.com"
        );
    }

    function isValidId(id) {
      return id is string &&
        id.size() > 0 &&
        id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasTenantField(data) {
      return data.keys().hasAny(['companyId', 'enterpriseId']);
    }

    function tenantMatches(data) {
      return (
        data.keys().hasAny(['companyId']) &&
        data.companyId is string &&
        data.companyId == authTenantId()
      ) || (
        data.keys().hasAny(['enterpriseId']) &&
        data.enterpriseId is string &&
        data.enterpriseId == authTenantId()
      );
    }

    function canReadDoc() {
      return isAdmin() ||
        (isSignedIn() && hasTenantField(resource.data) && tenantMatches(resource.data));
    }

    function canCreateDoc() {
      return isAdmin() ||
        (isSignedIn() && hasTenantField(request.resource.data) && tenantMatches(request.resource.data));
    }

    function canUpdateDoc() {
      return isAdmin() || (
        isSignedIn() &&
        hasTenantField(resource.data) &&
        tenantMatches(resource.data) &&
        hasTenantField(request.resource.data) &&
        tenantMatches(request.resource.data)
      );
    }

    function canDeleteDoc() {
      return isAdmin() ||
        (isSignedIn() && hasTenantField(resource.data) && tenantMatches(resource.data));
    }

    // Safety net
    match /{document=**} {
      allow read, write: if false;
    }

    match /masterKeys/{keyId} {
      allow get, list: if isValidId(keyId) && (isAdmin() || isSignedIn());
      allow create, delete: if isValidId(keyId) && isAdmin();
      allow update: if isValidId(keyId) && (
        isAdmin() ||
        (
          isSignedIn() &&
          !resource.data.used &&
          !resource.data.keys().hasAny(['revokedAt']) &&
          request.resource.data.used == true &&
          request.resource.data.key == resource.data.key &&
          request.resource.data.createdAt == resource.data.createdAt
        )
      );
    }

    match /enterprises/{entId} {
      allow read: if isAdmin() || (isSignedIn() && authTenantId() == entId);
      allow create, update, delete: if isAdmin() || (isSignedIn() && authTenantId() == entId);
    }

    match /rolePermissions/{roleId} {
      allow read: if isValidId(roleId) && canReadDoc();
      allow create: if isValidId(roleId) && canCreateDoc();
      allow update: if isValidId(roleId) && canUpdateDoc();
      allow delete: if isValidId(roleId) && canDeleteDoc();
    }

    match /shops/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /staff/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /products/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /orders/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /tables/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /inventory/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /backups/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /settings/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /shifts/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /reservations/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /printers/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /incidentReports/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /notifications/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /recountRequests/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /businessConfigs/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /staffSchedules/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /transactions/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /performance_events/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /suppliers/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /supplier_contracts/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /services/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }

    match /resources/{docId} {
      allow read: if isValidId(docId) && canReadDoc();
      allow create: if isValidId(docId) && canCreateDoc();
      allow update: if isValidId(docId) && canUpdateDoc();
      allow delete: if isValidId(docId) && canDeleteDoc();
    }
  }
}
